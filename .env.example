# Режим LLM: mock | local_only | local_dual | hybrid | cloud_only | replay
LLM_MODE=mock
# Облачные вызовы по умолчанию запрещены. Для hybrid и cloud_only поставить true.
ALLOW_CLOUD=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Облачный OpenAI-совместимый адрес. Ключ в этот файл не писать: только в локальный .env.
CASE_LLM_BASE_URL=https://changellenge.up.railway.app/v1
CASE_LLM_API_KEY=
# Токен администратора для настроек моделей
ADMIN_TOKEN=change-me
DEMO_MODE=true
# demo — три синтетические компании без CSV. case — витрина из CASE_DATA_DIR.
PROFILE_SOURCE=demo
DATA_DIR=data
CONFIG_DIR=config
LLM_CONFIG_PATH=config/llm.yaml
LOG_LEVEL=info
# Real-mode auth is for local development only. In production, disable registration until
# account recovery and deployment security are configured.
APP_ENV=development
APP_DB_PATH=data/app.sqlite3
AUTH_REGISTRATION_ENABLED=true
AUTH_COOKIE_SECURE=false
# Case inputs live outside the repository and are mounted read-only by Docker Compose.
CASE_DATA_DIR=../DATA/company_profile
BANK_PDF_DIR=../DATA/bank_analytics
# Имя файла GGUF в папке models/. Считает его llama-server на дискретной NVIDIA, не процессор.
LLM_GGUF_FILE=
# auto — если видеопамяти мало, хвост модели остаётся в оперативной памяти. gpu или ram фиксируют выбор.
LLM_PLACEMENT=auto
