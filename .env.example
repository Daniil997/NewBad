# Режим LLM: mock | local_only | local_dual | hybrid | cloud_only | replay
LLM_MODE=mock
# Облачные вызовы по умолчанию запрещены. Для hybrid и cloud_only поставить true.
ALLOW_CLOUD=false
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# Из письма организаторов кейса (адрес OpenAI-совместимого API и ключ):
CASE_LLM_BASE_URL=
CASE_LLM_API_KEY=
# Токен администратора для настроек моделей
ADMIN_TOKEN=change-me
DEMO_MODE=true
DATA_DIR=data
CONFIG_DIR=config
LLM_CONFIG_PATH=config/llm.yaml
LOG_LEVEL=info
# Имя файла GGUF в папке models/. Считает его llama-server на дискретной NVIDIA, не процессор.
LLM_GGUF_FILE=
