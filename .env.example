# Режим LLM: mock | local_only | local_dual | hybrid | cloud_only | replay
LLM_MODE=mock
# Разрешение облачных маршрутов; для вызовов также нужны ключ и модель по задаче.
ALLOW_CLOUD=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Облачный OpenAI-совместимый адрес. Ключ в этот файл не писать: только в локальный .env.
CASE_LLM_BASE_URL=https://api.alfahack-gateway26.ru/v1
CASE_LLM_API_KEY=
DATA_DIR=data
# Полные промпты и ответы LLM в консоли разработки; выключить можно значением false.
# В production подробное логирование содержимого выключено по умолчанию.
LLM_LOG_CONTENT=true
# Real-mode auth is for local development only. In production, disable registration until
# account recovery and deployment security are configured.
APP_ENV=development
APP_DB_PATH=data/app.sqlite3
AUTH_REGISTRATION_ENABLED=true
AUTH_COOKIE_SECURE=false
# Банковские PDF хранятся вне репозитория; Docker Compose монтирует их только для чтения.
# Optional alternate account-free bank corpus. Runtime never reads source PDFs.
BANK_CORPUS_PATH=data/bank/corpus.sqlite3
# auto — если видеопамяти мало, хвост модели остаётся в оперативной памяти. gpu или ram фиксируют выбор.
LLM_PLACEMENT=auto
